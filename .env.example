# ───────────────── GeniusPay (Netlify Functions, server-side) ─────────────────
GENIUS_PAY_API_KEY=your_api_key_here
GENIUS_PAY_API_SECRET=your_api_secret_here
GENIUS_PAY_BASE_URL=https://pay.genius.ci/api/v1/merchant
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8888,https://votre-domaine.com
GENIUS_PAY_PUBLIC_URL=https://votre-domaine.com

# ───────────────── Firebase (front, client-side) ─────────────────
# À récupérer dans console.firebase.google.com → Settings → Your apps → Web app config.
# Ces clés sont publiques par conception (la sécurité passe par les Firestore Rules
# et les domaines autorisés dans Auth).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
