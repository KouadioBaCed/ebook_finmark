# Clés GeniusPay (à obtenir auprès de pay.genius.ci)
GENIUS_PAY_API_KEY=your_api_key_here
GENIUS_PAY_API_SECRET=your_api_secret_here
GENIUS_PAY_BASE_URL=https://pay.genius.ci/api/v1/merchant

# Liste blanche des origines autorisées pour CORS et redirections post-paiement.
# Séparées par des virgules. Laisser vide en dev → permissif.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8888,https://votre-domaine.com

# (Optionnel) URL publique de fallback si aucun Origin n'est fourni.
GENIUS_PAY_PUBLIC_URL=https://votre-domaine.com
